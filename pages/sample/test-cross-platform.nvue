<template>
	<div class="content">
		<!-- 跨平台组件，铺满屏幕并置于底部 -->
		<ao-cross-flutter ref="crossFlutterView" class="flutter-container" :domain="domain" :options="options"></ao-cross-flutter>

		<!-- 按钮，放在顶部以便于操作 -->
		<div class="button-container">
			<button type="default" @click="onTestClick" class="action-button">测试跨平台组件</button>
		</div>
	</div>
</template>

<script>
	import {
		MeetExternalAPI
	} from "../../uni_modules/ao-cross-flutter/components/ao-cross-flutter/meeting-external-api"

	export default {
		data() {
			return {
				isAndroid: uni.getSystemInfoSync().platform === "android",
				domain: "https://aoeiuv020.github.io/livekit_meeting/",
				options: {
					serverUrl: "https://meet.livekit.io",
					room: "123456",
					name: "uni",
				},
			};
		},
		onLoad() {
			console.log('页面加载完成');
		},
		methods: {
			onTestClick() {
				console.log('按钮被点击');
				this.$refs.crossFlutterView.interceptHangUp(() => {
					console.log("interceptHangUp");
					this.$refs.crossFlutterView.hangUp();
					return true;
				});
			}
		}
	}
</script>

